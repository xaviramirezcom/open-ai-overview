# own-overview configuration. Copy to `.env` and edit.
# All keys are prefixed OWN_OVERVIEW_.

# --- provider selection ---
# "bedrock" (default, Guidewire-shaped) or "local" (zero-cloud, open-source).
OWN_OVERVIEW_LLM_PROVIDER=bedrock
OWN_OVERVIEW_EMBEDDING_PROVIDER=bedrock
OWN_OVERVIEW_VECTOR_STORE=opensearch      # opensearch | local
OWN_OVERVIEW_RERANKER=bedrock             # bedrock | none

# --- AWS / Bedrock ---
OWN_OVERVIEW_AWS_REGION=us-east-1
# Point at LocalStack for offline runs, e.g. http://localhost:4566 . Empty => real AWS.
OWN_OVERVIEW_AWS_ENDPOINT_URL=
OWN_OVERVIEW_BEDROCK_LLM_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
OWN_OVERVIEW_BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
OWN_OVERVIEW_BEDROCK_EMBEDDING_DIM=1024

# --- OpenSearch ---
OWN_OVERVIEW_OPENSEARCH_HOST=localhost
OWN_OVERVIEW_OPENSEARCH_PORT=9200
OWN_OVERVIEW_OPENSEARCH_USE_SSL=false

# --- CDA ingestion ---
OWN_OVERVIEW_CDA_BUCKET=own-overview-cda
OWN_OVERVIEW_CDA_LOCAL_ROOT=sample_data/cda
OWN_OVERVIEW_CDA_OUTPUT_MODE=merged       # merged | raw

# --- knobs ---
OWN_OVERVIEW_RETRIEVE_K=12
OWN_OVERVIEW_RERANK_K=5
OWN_OVERVIEW_GROUNDEDNESS_THRESHOLD=0.6

# For a fully local, no-AWS run with ZERO model downloads (instant demo), set:
#   OWN_OVERVIEW_LLM_PROVIDER=local          # EchoLLM (extractive, deterministic)
#   OWN_OVERVIEW_EMBEDDING_PROVIDER=hash     # hashing vectorizer, no torch download
#   OWN_OVERVIEW_VECTOR_STORE=local          # in-process + pickle persistence
#   OWN_OVERVIEW_RERANKER=none
# For realistic semantic embeddings locally, use EMBEDDING_PROVIDER=local
# (sentence-transformers; installs torch on first run) instead of hash.
